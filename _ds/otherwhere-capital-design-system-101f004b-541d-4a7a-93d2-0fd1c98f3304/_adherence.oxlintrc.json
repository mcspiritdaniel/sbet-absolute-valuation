{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/data/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair Display|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Playfair Display, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BridgeRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|variant|key|ref|className|style|children)$/]",
        "message": "<BridgeRow> doesn't accept that prop. Declared props: label, value, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='BridgeRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|total|highlight|muted|negative)$/]",
        "message": "<BridgeRow> variant must be one of 'default' | 'total' | 'highlight' | 'muted' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|unit|onChange|isStatic|caption|key|ref|className|style|children)$/]",
        "message": "<GridCell> doesn't accept that prop. Declared props: value, min, max, step, unit, onChange, isStatic, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridCell'] > JSXAttribute[name.name='unit'] > Literal[value!=/^(?:%|%-raw|x|)$/]",
        "message": "<GridCell> unit must be one of '%' | '%-raw' | 'x' | ''."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:ticker|company|section|actions|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: ticker, company, section, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='SliderControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|unit|onChange|formatValue|key|ref|className|style|children)$/]",
        "message": "<SliderControl> doesn't accept that prop. Declared props: label, value, min, max, step, unit, onChange, formatValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='SliderControl'] > JSXAttribute[name.name='unit'] > Literal[value!=/^(?:%|%-raw|\\$|\\$M|x|yr|)$/]",
        "message": "<SliderControl> unit must be one of '%' | '%-raw' | '$' | '$M' | 'x' | 'yr' | ''."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "BridgeRow": {
        "replaces": []
      },
      "GridCell": {
